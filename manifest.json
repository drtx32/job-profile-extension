{
  "manifest_version": 3,
  "name": "表单资料助手",
  "version": "1.2.4",
  "author": "drtx32",
  "homepage_url": "https://github.com/drtx32/job-profile-extension",
  "description": "从本地资料表快速读取字段，并辅助填写网页表单",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "web_accessible_resources": [
    {
      "resources": ["agent-bridge.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["agent-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["xlsx.full.min.js", "content.js"],
      "css": ["styles.css"],
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开表单资料助手"
  },
  "commands": {
    "repeat-selected-value": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "在当前表单字段重复填入上次选择的信息"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
